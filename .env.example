NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
# フロントが認証成功時にセットする marker Cookie 名。
# Laravel Sanctum のセッション Cookie (HttpOnly) は CSRF 取得・ログイン失敗時にも付与され
# 「Cookie 存在 = 認証済み」と判定できないため、専用 marker cookie を分離する。
# 値は固定 '1' (存在判定のみ・秘匿情報含めず) で、有効期限 (Max-Age=120分) で認証状態を管理
NEXT_PUBLIC_AUTH_COOKIE_NAME=scenespeak-auth
